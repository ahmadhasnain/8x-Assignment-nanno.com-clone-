generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// SQLite has no native enum support in Prisma; role is "CREATOR" | "COMPANY".
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  role      String
  createdAt DateTime @default(now())

  creatorProfile CreatorProfile?
  companyProfile CompanyProfile?
}

model CreatorProfile {
  id            String   @id @default(cuid())
  user          User     @relation(fields: [userId], references: [id])
  userId        String   @unique

  onboardingStep Int     @default(1)

  linkedinUrl   String?
  fullName      String?
  headline      String?
  photoUrl      String?
  country       String?
  countryFlag   String?
  followers     Int?

  reactionsPerPost   Int?
  impressionsPerPost Int?
  commentsPerPost    Int?
  engagementRate     Float?

  industries    String? // JSON-encoded string array, up to 3
  bio           String?
  pricePerPost  Float?
  bundleEnabled Boolean  @default(false)

  completed     Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CompanyProfile {
  id          String   @id @default(cuid())
  user        User     @relation(fields: [userId], references: [id])
  userId      String   @unique
  companyName String?
  website     String?

  onboardingStep   Int     @default(1)
  valueProposition String?
  icps             String? // JSON-encoded array of 3 { title, description }
  completed        Boolean @default(false)

  campaigns Campaign[]

  createdAt   DateTime @default(now())
}

model Campaign {
  id          String   @id @default(cuid())
  company     CompanyProfile @relation(fields: [companyId], references: [id])
  companyId   String
  title       String
  description String
  icps        String? // JSON-encoded array of 3 { title, description }
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
}
